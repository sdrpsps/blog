---
import '../styles/globals.css';
import { config } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  isPostPage?: boolean;
}

const {
  title = config.metadata.title as string,
  description = config.metadata.description as string,
  image = '',
  canonical,
  isPostPage = false,
} = Astro.props;

const siteTitle = title === config.metadata.title ? title : `${title} | ${config.metadata.title}`;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    {config.metadata.keywords && <meta name="keywords" content={config.metadata.keywords.join(', ')} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/avatar.png" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isPostPage ? 'article' : 'website'} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    {image && <meta property="twitter:image" content={image} />}
    
    <!-- DNS prefetch & LXGW Font -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-lite-webfont@1.1.0/style.css" media="print" onload="this.media='all'" />
    
    <!-- Prevent theme flash -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'system';
      };
      const theme = getTheme();
      const root = document.documentElement;
      root.classList.remove('light', 'dark');
      if (theme === 'system') {
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.classList.add(systemTheme);
      } else {
        root.classList.add(theme);
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <!-- 主书籍装帧网格容器 -->
    <div class="flex-1 flex flex-col w-full mx-auto transition-all duration-500 ease-in-out book-border-l book-border-r max-w-5xl">
      <header class="px-6 pt-10">
        <div class="flex h-16 items-center justify-between">
          <a href="/" title="首页" class="flex items-center gap-3 group">
            <img
              src="/avatar.png"
              alt="logo"
              width="36"
              height="36"
              class="rounded-full transition-all duration-500 group-hover:rotate-12 group-hover:scale-105"
            />
            <span class="text-xs font-semibold tracking-widest text-foreground group-hover:text-accent transition-colors duration-300">
              SUNNY'S SPACE
            </span>
          </a>
          
          <div class="flex items-center gap-6">
            <!-- 极简导航链接 -->
            <nav class="hidden sm:flex items-center gap-6">
              <a href="/" class="text-xs tracking-widest text-muted-foreground hover:text-foreground fancy-link uppercase">首页</a>
              <a href="/posts" class="text-xs tracking-widest text-muted-foreground hover:text-foreground fancy-link uppercase">文章</a>
            </nav>

            <div class="w-[0.5px] h-4 bg-border hidden sm:block"></div>

            <div class="flex items-center gap-2">
              <!-- Theme Toggle -->
              <button
                id="theme-toggle"
                class="relative w-9 h-9 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer text-muted-foreground hover:text-foreground flex items-center justify-center"
                title="切换主题"
                aria-label="Toggle theme"
              >
                <!-- System Icon -->
                <svg id="theme-system-icon" class="w-5 h-5 transition-all duration-500 transform absolute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4" />
                  <path d="M12 2v2" />
                  <path d="M12 20v2" />
                  <path d="m4.9 4.9 1.4 1.4" />
                  <path d="m17.7 17.7 1.4 1.4" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                  <path d="m6.3 17.7-1.4 1.4" />
                  <path d="m19 4.9-1.4 1.4" />
                </svg>
                <!-- Light Icon -->
                <svg id="theme-light-icon" class="w-5 h-5 transition-all duration-500 transform absolute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2" />
                  <path d="M12 20v2" />
                  <path d="m4.93 4.93 1.41 1.41" />
                  <path d="m17.66 17.66 1.41 1.41" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                  <path d="m6.34 17.66-1.41 1.41" />
                  <path d="m19.07 4.93-1.41 1.41" />
                </svg>
                <!-- Dark Icon -->
                <svg id="theme-dark-icon" class="w-5 h-5 transition-all duration-500 transform absolute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                </svg>
              </button>
              
              <!-- RSS Link -->
              <a
                href="/rss.xml"
                class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:-translate-y-0.5 transition-all duration-300 text-muted-foreground hover:text-foreground"
                title="RSS 订阅"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 11a9 9 0 0 1 9 9" />
                  <path d="M4 4a16 16 0 0 1 16 16" />
                  <circle cx="5" cy="19" r="1" />
                </svg>
              </a>

              <!-- GitHub Link -->
              <a
                href="https://github.com/sdrpsps"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:-translate-y-0.5 transition-all duration-300 text-muted-foreground hover:text-foreground"
                title="Github"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </header>

      <main class="flex-1 w-full">
        <slot />
      </main>

      <footer class="mt-auto py-12 border-t border-border/30">
        <div class="px-6 text-xs tracking-widest text-muted-foreground/80 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-center sm:text-left">
            <span>© 2024 - {new Date().getFullYear()} Sunny Chou</span>
          </p>
          <p class="text-center sm:text-right">
            <span class="mx-1">Powered by</span>
            <a class="underline hover:text-accent transition-colors" href="https://github.com/sdrpsps/blog">
              Astro Blog
            </a>
          </p>
        </div>
      </footer>
    </div>

    <!-- Theme Control Client Script -->
    <script>
      type Theme = 'light' | 'dark' | 'system';
      const toggleBtn = document.getElementById('theme-toggle');
      const systemIcon = document.getElementById('theme-system-icon');
      const lightIcon = document.getElementById('theme-light-icon');
      const darkIcon = document.getElementById('theme-dark-icon');

      const getTheme = (): Theme => {
        return (localStorage.getItem('theme') as Theme) || 'system';
      };

      const updateUI = (theme: Theme) => {
        // 清除所有的显示/变形状态，默认设为 absolute, opacity-0, scale-50, rotate-90
        const icons = [systemIcon, lightIcon, darkIcon];
        icons.forEach(icon => {
          icon?.classList.add('opacity-0', 'scale-50', 'rotate-90', 'absolute');
          icon?.classList.remove('opacity-100', 'scale-100', 'rotate-0');
        });

        let activeIcon = systemIcon;
        if (theme === 'light') {
          activeIcon = lightIcon;
        } else if (theme === 'dark') {
          activeIcon = darkIcon;
        }

        // 激活当前主题的图标，移除 absolute 保证位置居中并淡入变形
        if (activeIcon) {
          activeIcon.classList.remove('opacity-0', 'scale-50', 'rotate-90', 'absolute');
          activeIcon.classList.add('opacity-100', 'scale-100', 'rotate-0');
        }

        // 应用主题
        const root = document.documentElement;
        root.classList.remove('light', 'dark');
        if (theme === 'system') {
          const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          root.classList.add(systemTheme);
        } else {
          root.classList.add(theme);
        }
      };

      // 首次加载应用
      let currentTheme = getTheme();
      updateUI(currentTheme);

      toggleBtn?.addEventListener('click', () => {
        if (currentTheme === 'light') {
          currentTheme = 'dark';
        } else if (currentTheme === 'dark') {
          currentTheme = 'system';
        } else {
          currentTheme = 'light';
        }
        localStorage.setItem('theme', currentTheme);
        updateUI(currentTheme);
      });

      // 监听系统主题变化
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (getTheme() === 'system') {
          updateUI('system');
        }
      });
    </script>
  </body>
</html>

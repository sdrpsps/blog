---
import { getCollection } from 'astro:content';
import count from 'word-count';
import Layout from '../layouts/Layout.astro';
import { config } from '../lib/config';
import { formatDate } from '../lib/utils';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title={config.metadata.title as string}>
  <main class="max-w-2xl mx-auto px-6 py-16">
    <!-- Header/Hero section with generous whitespace -->
    <div class="mb-20 space-y-4">
      <h1 class="text-3xl font-semibold tracking-tight text-foreground">
        {config.metadata.title}
      </h1>
      <p class="text-sm text-muted-foreground font-light leading-relaxed max-w-md">
        {config.author.bio} · {config.metadata.description}
      </p>
    </div>

    <!-- Recommended reading list -->
    <div class="space-y-12">
      <h2 class="text-xs font-semibold tracking-widest uppercase text-muted-foreground border-b border-border pb-2 mb-8">
        推荐阅读
      </h2>
      <div class="space-y-10">
        {sortedPosts.map((post) => (
          <article class="group">
            <a href={`/posts/${post.id}`} class="block space-y-2">
              {post.data.image && (
                <div class="mb-4 overflow-hidden rounded-md bg-neutral-100 dark:bg-neutral-900 aspect-video max-h-48 w-full">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="object-cover h-full w-full opacity-90 group-hover:opacity-100 group-hover:scale-[1.01] transition-all duration-500 ease-in-out"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="space-y-1">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h3 class="text-lg font-medium text-foreground group-hover:text-primary transition-colors duration-150">
                    {post.data.title}
                  </h3>
                  <span class="text-xs text-muted-foreground whitespace-nowrap">
                    {formatDate(post.data.date)} · {count(post.body || '')} 字
                  </span>
                </div>
                {post.data.summary && (
                  <p class="text-sm text-muted-foreground line-clamp-2 leading-relaxed font-light">
                    {post.data.summary}
                  </p>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>

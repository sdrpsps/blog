---
import { getCollection } from 'astro:content';
import count from 'word-count';
import Layout from '../../layouts/Layout.astro';
import { config } from '../../lib/config';
import { formatDate } from '../../lib/utils';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="文章" description={config.metadata.description as string}>
  <main class="max-w-2xl mx-auto px-6 py-16">
    <div class="mb-14">
      <h1 class="text-2xl font-semibold text-foreground tracking-tight">所有文章</h1>
      <p class="text-xs text-muted-foreground mt-2 font-light">
        共收录 {sortedPosts.length} 篇文章
      </p>
    </div>

    <div class="space-y-12">
      {sortedPosts.map((post) => (
        <article class="group">
          <a href={`/posts/${post.id}`} class="block space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h2 class="text-lg font-medium text-foreground group-hover:text-primary transition-colors duration-150">
                {post.data.title}
              </h2>
              <span class="text-xs text-muted-foreground whitespace-nowrap">
                {formatDate(post.data.date)} · {count(post.body || '')} 字
              </span>
            </div>
            {post.data.summary && (
              <p class="text-sm text-muted-foreground line-clamp-2 leading-relaxed font-light">
                {post.data.summary}
              </p>
            )}
          </a>
        </article>
      ))}
    </div>
  </main>
</Layout>
